<?php

/**
 * @file
 * Install hooks for the Fun room module.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\fun_room\Entity\FunParticipant;

/**
 * Implements hook_install().
 */
function fun_room_install(): void {
  // Core JSON:API is read-only by default; participants are created through it.
  \Drupal::configFactory()
    ->getEditable('jsonapi.settings')
    ->set('read_only', FALSE)
    ->save();

  user_role_grant_permissions('anonymous', ['join fun room']);
  user_role_grant_permissions('authenticated', ['join fun room']);

  // Drupal CMS adds every new node type to its editorial workflow, which keeps
  // new rooms as unpublished drafts (and so a 404 for attendees). A room is just
  // open or closed, so take it out of moderation.
  if (\Drupal::moduleHandler()->moduleExists('workflows')) {
    foreach (\Drupal::entityTypeManager()->getStorage('workflow')->loadMultiple() as $workflow) {
      $plugin = $workflow->getTypePlugin();
      if (method_exists($plugin, 'appliesToEntityTypeAndBundle') && $plugin->appliesToEntityTypeAndBundle('node', 'room')) {
        $plugin->removeEntityTypeAndBundle('node', 'room');
        $workflow->save();
      }
    }
  }
}

/**
 * Adds the current slide title field to rooms.
 *
 * Config in config/install only applies when the module is first installed, so
 * existing sites get the new field here.
 */
function fun_room_update_10001(): void {
  $source = new FileStorage(\Drupal::service('extension.list.module')->getPath('fun_room') . '/config/install');
  $config_manager = \Drupal::service('config.manager');
  $entity_type_manager = \Drupal::entityTypeManager();

  // The storage first, then the instance that uses it.
  foreach (['field.storage.node.field_current_slide_title', 'field.field.node.room.field_current_slide_title'] as $name) {
    if (!\Drupal::configFactory()->get($name)->isNew()) {
      continue;
    }
    $entity_type_manager->getStorage($config_manager->getEntityTypeIdByName($name))
      ->createFromStorageRecord($source->read($name))
      ->save();
  }

  $display = EntityFormDisplay::load('node.room.default');
  if ($display && !$display->getComponent('field_current_slide_title')) {
    $display->setComponent('field_current_slide_title', [
      'type' => 'string_textfield',
      'weight' => 4,
      'region' => 'content',
      'settings' => ['size' => 60, 'placeholder' => ''],
    ])->save();
  }
}

/**
 * Adds votes and the participant fun fields for the slider and swarm.
 *
 * Fresh installs get these from the entity definitions; existing sites need the
 * new entity type and fields installed.
 */
function fun_room_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  $participant_fields = FunParticipant::baseFieldDefinitions($entity_type_manager->getDefinition('fun_participant'));
  foreach (['fun', 'fun_at'] as $name) {
    if (!$manager->getFieldStorageDefinition($name, 'fun_participant')) {
      $manager->installFieldStorageDefinition($name, 'fun_participant', 'fun_room', $participant_fields[$name]);
    }
  }

  if (!$manager->getEntityType('fun_vote')) {
    $manager->installEntityType($entity_type_manager->getDefinition('fun_vote'));
  }
}
