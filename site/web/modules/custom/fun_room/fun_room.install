<?php

/**
 * @file
 * Install hooks for the Fun room module.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function fun_room_install(): void {
  // Core JSON:API is read-only by default; participants are created through it.
  \Drupal::configFactory()
    ->getEditable('jsonapi.settings')
    ->set('read_only', FALSE)
    ->save();

  user_role_grant_permissions('anonymous', ['join fun room']);
  user_role_grant_permissions('authenticated', ['join fun room']);

  // Drupal CMS adds every new node type to its editorial workflow, which keeps
  // new rooms as unpublished drafts (and so a 404 for attendees). A room is just
  // open or closed, so take it out of moderation.
  if (\Drupal::moduleHandler()->moduleExists('workflows')) {
    foreach (\Drupal::entityTypeManager()->getStorage('workflow')->loadMultiple() as $workflow) {
      $plugin = $workflow->getTypePlugin();
      if (method_exists($plugin, 'appliesToEntityTypeAndBundle') && $plugin->appliesToEntityTypeAndBundle('node', 'room')) {
        $plugin->removeEntityTypeAndBundle('node', 'room');
        $workflow->save();
      }
    }
  }
}
