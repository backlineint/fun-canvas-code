# Copy to .env.local (ignored by git) and fill in. Vite only reads VITE_ variables.

# The Drupal site's origin; leave empty to use the built-in simulated room.
VITE_ROOM_API=https://fun-canvas-code.ddev.site

# The room to update. Override per session with ?room=CODE in the deck's URL.
VITE_ROOM_CODE=NED-4261

# The shared presenter key. It must match FUN_ROOM_PRESENTER_KEY on the site
# (see site/web/modules/custom/fun_room/README.md). It is baked into the dev
# bundle, so never deploy that bundle publicly.
VITE_PRESENTER_KEY=
